<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages</title>
</head>
<body>
    <div>
        <a href="/">Home</a>
        <a href="/log-out">log out</a>
    </div>
    <div>
        <h1>Messages</h1>
        <button
            type="button"
            onclick="document.getElementById('newMessageModal').showModal()"
        >
            new
        </button>
    </div>
    <% if (messages) {%>
        <ul>
            <% messages.map((message) => {%>
                <li>
                    <div>
                        Title: <%=message.title %>
                        Message: <%=message.message %>
                        By: <%=message.username %>
                        at: <%=message.time %>
                        <% if (locals.currentUser && locals.currentUser.is_admin) {%>
                            <form action="/messages/deleteMessage/<%= message.message_id %>" method="POST">
                                <button type="submit">Delete</button>
                            </form>
                            <%} %>
                    </div>
                </li>
            <%})%>
        </ul>
    <%}
    %>
    <dialog id="newMessageModal">
        <div>
            <h2>New message</h2>
            <button type="button" onClick="document.getElementById('newMessageModal').close()">Close</button>
        </div>
        <form method="POST" action="/messages/new">
            <div>
                <label for="title">Title:</label>
                <input type="text" id="title" name="title">
            </div>
            <div>
                <label for="message">Message:</label>
                <textarea name="message" id="message"></textarea>
            </div>
            <button type="submit">Post</button>
        </form>
    </dialog>

</body>
</html>