<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages</title>
</head>
<body>
    <div>
        <a href="/">Home</a>
        <a href="/log-out">log out</a>
    </div>
    <div>
        <h1>Messages</h1>
        <button>new</button>
    </div>
    <% if (messages) {%>
        <ul>
            <% messages.map((message) => {%>
                <li>
                    <div>
                        Title: <%=message.title %>
                        Message: <%=message.message %>
                        By: <%=message.username %>
                        at: <%=message.time %>
                    </div>
                </li>
            <%})%>
        </ul>
    <%}
    %>
</body>
</html>